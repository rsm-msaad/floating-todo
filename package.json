{
  "name": "floating-todo",
  "version": "1.0.0",
  "description": "A tiny always-on-top checklist for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . Checklist --platform=darwin --arch=arm64 --icon=./icon.icns --app-bundle-id=com.mernasalama.checklist --overwrite --out=dist --extend-info=extend-info.plist"
  },
  "devDependencies": {
    "@electron/packager": "^18.0.0",
    "electron": "^32.0.0"
  }
}
